{
  "name": "ghostnode",
  "version": "0.3.1",
  "private": false,
  "description": "Privacy firewall for Node.js apps that detects sensitive data leaving your process.",
  "license": "MIT",
  "author": "DARKSOL",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "ghostnode": "src/cli.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./http": "./src/http.js",
    "./logger": "./src/logger.js",
    "./register": "./src/register.js",
    "./shield": "./src/shield.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "assets/darksol-banner.png"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "lint": "node --test",
    "prepublishOnly": "npm test && npm pack --dry-run"
  },
  "keywords": [
    "privacy",
    "security",
    "firewall",
    "redaction",
    "pii",
    "token-sanitization",
    "telemetry",
    "logging",
    "node"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darks0l/ghostnode.git"
  },
  "homepage": "https://github.com/darks0l/ghostnode#readme",
  "bugs": {
    "url": "https://github.com/darks0l/ghostnode/issues"
  }
}
